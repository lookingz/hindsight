# Hindsight Docker Image - Deployment Override
# Extends the original Dockerfile with China mirror and proxy support.
#
# This file should ONLY exist on the deployment server, NOT committed to the repo.
# When upstream updates, just re-run the build with this file.
#
# Additional build args (on top of original):
#   BUILD_PROXY=http://host:port   - HTTP proxy for build-time downloads (optional)
#   HF_TOKEN=<token>               - HuggingFace token for gated models (optional)
#
# Examples:
#   docker build -f docker/standalone/Dockerfile.deploy -t hindsight .
#   docker build -f docker/standalone/Dockerfile.deploy \
#     --build-arg BUILD_PROXY=http://localhost:7890 \
#     --build-arg HF_TOKEN=hf_xxx \
#     -t hindsight .

ARG INCLUDE_API=true
ARG INCLUDE_CP=true
ARG PRELOAD_ML_MODELS=true
ARG INCLUDE_LOCAL_MODELS=true
ARG BUILD_PROXY=""
ARG HF_TOKEN=""

# =============================================================================
# Stage: API Builder
# =============================================================================
FROM python:3.11-slim AS api-builder

ARG INCLUDE_API
ARG INCLUDE_LOCAL_MODELS
ARG BUILD_PROXY
RUN if [ "$INCLUDE_API" != "true" ]; then echo "Skipping API build" && exit 0; fi

WORKDIR /app

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple uv

COPY hindsight-api-slim/pyproject.toml ./api/
COPY hindsight-api-slim/README.md ./api/

WORKDIR /app/api

RUN if [ "$INCLUDE_LOCAL_MODELS" = "true" ]; then \
        uv sync --extra local-ml --extra embedded-db; \
    else \
        uv sync --extra embedded-db; \
    fi

COPY hindsight-api-slim/hindsight_api ./hindsight_api
RUN uv pip install -e .

# =============================================================================
# Stage: SDK Builder
# =============================================================================
FROM node:20-slim AS sdk-builder

ARG INCLUDE_CP
ARG BUILD_PROXY
RUN if [ "$INCLUDE_CP" != "true" ]; then echo "Skipping SDK build" && exit 0; fi

WORKDIR /app

COPY package.json package-lock.json ./
COPY hindsight-clients/typescript/ ./hindsight-clients/typescript/

RUN if [ -n "$BUILD_PROXY" ]; then \
      npm config set proxy "$BUILD_PROXY" && \
      npm config set https-proxy "$BUILD_PROXY"; \
    fi && \
    npm config set registry https://registry.npmmirror.com && \
    npm ci --ignore-scripts -w @vectorize-io/hindsight-client && \
    npm run build -w @vectorize-io/hindsight-client

# =============================================================================
# Stage: Control Plane Builder
# =============================================================================
FROM node:20-slim AS cp-builder

ARG INCLUDE_CP
ARG BUILD_PROXY
RUN if [ "$INCLUDE_CP" != "true" ]; then echo "Skipping CP build" && exit 0; fi

WORKDIR /app

COPY package.json package-lock.json ./
COPY hindsight-control-plane/package.json ./hindsight-control-plane/
RUN if [ -n "$BUILD_PROXY" ]; then \
      npm config set proxy "$BUILD_PROXY" && \
      npm config set https-proxy "$BUILD_PROXY"; \
    fi && \
    npm config set registry https://registry.npmmirror.com && \
    npm config set fund false && \
    npm config set audit false && \
    sed -i '/"@vectorize-io\/hindsight-client":/d' ./hindsight-control-plane/package.json && \
    npm ci --ignore-scripts --workspace=hindsight-control-plane --include-workspace-root=false

WORKDIR /app/hindsight-control-plane

COPY hindsight-control-plane/ ./
RUN rm -f package-lock.json && sed -i '/"@vectorize-io\/hindsight-client":/d' package.json
COPY --from=sdk-builder /app/hindsight-clients/typescript ./node_modules/@vectorize-io/hindsight-client

ARG NEXT_PUBLIC_BASE_PATH=""
RUN npm exec -- next build

RUN STANDALONE_ROOT=$(find .next/standalone -path '*/node_modules' -prune -o -name 'server.js' -print | head -1 | xargs dirname) && \
    mkdir -p standalone && \
    cp -r "$STANDALONE_ROOT"/* standalone/ && \
    cp -r "$STANDALONE_ROOT"/.next standalone/.next && \
    if [ -d ".next/standalone/node_modules" ] && [ "$STANDALONE_ROOT" != ".next/standalone" ]; then \
      cp -r .next/standalone/node_modules standalone/node_modules; \
    fi && \
    cp -r .next/static standalone/.next/static && \
    mkdir -p standalone/public && \
    cp -r public/* standalone/public/ 2>/dev/null || true && \
    test -f standalone/server.js || (echo "ERROR: server.js missing!" && exit 1) && \
    test -f standalone/.next/BUILD_ID || (echo "ERROR: BUILD_ID missing!" && exit 1)

# =============================================================================
# Stage: Final Image - API Only
# =============================================================================
FROM python:3.11-slim AS api-only

WORKDIR /app

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y \
    curl \
    procps \
    libxml2 \
    libssl3 \
    libgssapi-krb5-2 \
    libossp-uuid16 \
    && (apt-get install -y libicu72 2>/dev/null || apt-get install -y libicu74 2>/dev/null || apt-get install -y libicu76 2>/dev/null || true) \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple uv

RUN useradd -m -s /bin/bash hindsight

COPY --from=api-builder /app/api /app/api
COPY docker/standalone/start-all.sh /app/start-all.sh
RUN chmod +x /app/start-all.sh
RUN chown -R hindsight:hindsight /app

USER hindsight
RUN mkdir -p /home/hindsight/.pg0

ENV PATH="/app/api/.venv/bin:${PATH}"

# tiktoken pre-download removed with upstream v0.9.2: the tokenizer is now
# quicktok, whose vocabularies ship inside the wheel - nothing to fetch.
ARG BUILD_PROXY

# Pre-download ML models (with optional proxy and HF_TOKEN)
ARG PRELOAD_ML_MODELS
ARG INCLUDE_LOCAL_MODELS
ARG HF_TOKEN
ARG HF_ENDPOINT
ENV HF_HUB_DOWNLOAD_TIMEOUT=600
RUN if [ -n "$BUILD_PROXY" ]; then export http_proxy="$BUILD_PROXY" https_proxy="$BUILD_PROXY"; fi && \
    if [ -n "$HF_TOKEN" ]; then export HF_TOKEN="$HF_TOKEN"; fi && \
    if [ -n "$HF_ENDPOINT" ]; then export HF_ENDPOINT="$HF_ENDPOINT"; fi && \
    if [ "$PRELOAD_ML_MODELS" = "true" ] && [ "$INCLUDE_LOCAL_MODELS" = "true" ]; then \
    MAX_RETRIES=3; \
    RETRY_DELAY=10; \
    for i in $(seq 1 $MAX_RETRIES); do \
      echo "Attempt $i/$MAX_RETRIES: Downloading ML models..."; \
      echo "Using HF_ENDPOINT=${HF_ENDPOINT:-<unset>}"; \
      echo "Build proxy configured=$([ -n "$BUILD_PROXY" ] && echo yes || echo no)"; \
      /app/api/.venv/bin/python -c "\
import os; os.environ['HF_HUB_DOWNLOAD_TIMEOUT'] = '600'; \
from sentence_transformers import SentenceTransformer, CrossEncoder; \
print('Downloading embedding model...'); \
SentenceTransformer('BAAI/bge-small-en-v1.5'); \
print('Downloading cross-encoder model...'); \
CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2'); \
print('Models cached successfully')" && break; \
      if [ $i -lt $MAX_RETRIES ]; then \
        echo "Attempt $i failed, retrying in ${RETRY_DELAY}s..."; \
        sleep $RETRY_DELAY; \
        RETRY_DELAY=$((RETRY_DELAY * 2)); \
      fi; \
    done; \
    if [ $i -eq $MAX_RETRIES ] && ! /app/api/.venv/bin/python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')" 2>/dev/null; then \
      echo "ERROR: Failed to download models after $MAX_RETRIES attempts"; \
      exit 1; \
    fi; \
    elif [ "$INCLUDE_LOCAL_MODELS" != "true" ]; then echo "Skipping ML model preload (local-models not included)"; \
    else echo "Skipping ML model preload"; fi

EXPOSE 8888

ENV HINDSIGHT_API_HOST=0.0.0.0
ENV HINDSIGHT_API_PORT=8888
ENV HINDSIGHT_API_LOG_LEVEL=info
ENV HINDSIGHT_ENABLE_API=true
ENV HINDSIGHT_ENABLE_CP=false
ENV PYTHONUNBUFFERED=1
# Clear build proxy so it doesn't leak into runtime
ENV http_proxy=""
ENV https_proxy=""
ENV HTTP_PROXY=""
ENV HTTPS_PROXY=""
ENV TRANSFORMERS_VERBOSITY=error
ENV HF_HUB_VERBOSITY=error
ENV TOKENIZERS_PARALLELISM=false

CMD ["/app/start-all.sh"]

# =============================================================================
# Stage: Final Image - Control Plane Only
# =============================================================================
FROM node:20-alpine AS cp-only

WORKDIR /app

COPY --from=sdk-builder /app/hindsight-clients/typescript /app/sdk

WORKDIR /app/control-plane
COPY --from=cp-builder /app/hindsight-control-plane/standalone ./
COPY --from=cp-builder /app/hindsight-control-plane/.next/static ./.next/static
COPY --from=cp-builder /app/hindsight-control-plane/public ./public

WORKDIR /app

COPY docker/standalone/start-all.sh /app/start-all.sh
RUN chmod +x /app/start-all.sh

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk add --no-cache curl bash

EXPOSE 9999

ENV NODE_ENV=production
ENV HINDSIGHT_CP_DATAPLANE_API_URL=http://localhost:8888
ENV HINDSIGHT_ENABLE_API=false
ENV HINDSIGHT_ENABLE_CP=true

CMD ["/app/start-all.sh"]

# =============================================================================
# Stage: Final Image - Standalone (both API and Control Plane)
# =============================================================================
FROM python:3.11-slim AS standalone

WORKDIR /app

ARG BUILD_PROXY
RUN if [ -n "$BUILD_PROXY" ]; then export http_proxy="$BUILD_PROXY" https_proxy="$BUILD_PROXY"; fi && \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y \
    curl \
    procps \
    libxml2 \
    libssl3 \
    libgssapi-krb5-2 \
    libossp-uuid16 \
    && (apt-get install -y libicu72 2>/dev/null || apt-get install -y libicu74 2>/dev/null || apt-get install -y libicu76 2>/dev/null || true) \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple uv

RUN useradd -m -s /bin/bash hindsight

COPY --from=api-builder /app/api /app/api
COPY --from=sdk-builder /app/hindsight-clients/typescript /app/sdk

WORKDIR /app/control-plane
COPY --from=cp-builder /app/hindsight-control-plane/standalone ./
COPY --from=cp-builder /app/hindsight-control-plane/.next/static ./.next/static
COPY --from=cp-builder /app/hindsight-control-plane/public ./public

WORKDIR /app

COPY docker/standalone/start-all.sh /app/start-all.sh
RUN chmod +x /app/start-all.sh
RUN chown -R hindsight:hindsight /app

USER hindsight
RUN mkdir -p /home/hindsight/.pg0

ENV PATH="/app/api/.venv/bin:${PATH}"

# tiktoken pre-download removed with upstream v0.9.2: the tokenizer is now
# quicktok, whose vocabularies ship inside the wheel - nothing to fetch.
ARG BUILD_PROXY

# Pre-download ML models (with optional proxy and HF_TOKEN)
ARG PRELOAD_ML_MODELS
ARG INCLUDE_LOCAL_MODELS
ARG HF_TOKEN
ARG HF_ENDPOINT
ENV HF_HUB_DOWNLOAD_TIMEOUT=600
RUN if [ -n "$HF_TOKEN" ]; then export HF_TOKEN="$HF_TOKEN"; fi && \
    if [ -n "$HF_ENDPOINT" ]; then export HF_ENDPOINT="$HF_ENDPOINT"; fi && \
    if [ "$PRELOAD_ML_MODELS" = "true" ] && [ "$INCLUDE_LOCAL_MODELS" = "true" ]; then \
    MAX_RETRIES=3; \
    RETRY_DELAY=10; \
    for i in $(seq 1 $MAX_RETRIES); do \
      echo "Attempt $i/$MAX_RETRIES: Downloading ML models..."; \
      /app/api/.venv/bin/python -c "\
import os; os.environ['HF_HUB_DOWNLOAD_TIMEOUT'] = '600'; \
from sentence_transformers import SentenceTransformer, CrossEncoder; \
print('Downloading embedding model...'); \
SentenceTransformer('BAAI/bge-small-en-v1.5'); \
print('Downloading cross-encoder model...'); \
CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2'); \
print('Models cached successfully')" && break; \
      if [ $i -lt $MAX_RETRIES ]; then \
        echo "Attempt $i failed, retrying in ${RETRY_DELAY}s..."; \
        sleep $RETRY_DELAY; \
        RETRY_DELAY=$((RETRY_DELAY * 2)); \
      fi; \
    done; \
    if [ $i -eq $MAX_RETRIES ] && ! /app/api/.venv/bin/python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')" 2>/dev/null; then \
      echo "ERROR: Failed to download models after $MAX_RETRIES attempts"; \
      exit 1; \
    fi; \
    elif [ "$INCLUDE_LOCAL_MODELS" != "true" ]; then echo "Skipping ML model preload (local-models not included)"; \
    else echo "Skipping ML model preload"; fi

EXPOSE 8888 9999

ENV HINDSIGHT_API_HOST=0.0.0.0
ENV HINDSIGHT_API_PORT=8888
ENV HINDSIGHT_API_LOG_LEVEL=info
ENV NODE_ENV=production
ENV HINDSIGHT_CP_DATAPLANE_API_URL=http://localhost:8888
ENV HINDSIGHT_ENABLE_API=true
ENV HINDSIGHT_ENABLE_CP=true
ENV PYTHONUNBUFFERED=1
# Clear build proxy so it doesn't leak into runtime
ENV http_proxy=""
ENV https_proxy=""
ENV HTTP_PROXY=""
ENV HTTPS_PROXY=""
ENV TRANSFORMERS_VERBOSITY=error
ENV HF_HUB_VERBOSITY=error
ENV TOKENIZERS_PARALLELISM=false

CMD ["/app/start-all.sh"]

FROM standalone
