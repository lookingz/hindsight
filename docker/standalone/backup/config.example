# Non-secret settings for backup-cn.py. Copy to `config` next to the script.
# KEY=VALUE; quotes are optional.

# Where the timestamped ZIPs are kept. Put this on the volume with room, not on
# a crowded root filesystem.
BACKUP_DIR=/srv/build/artifacts/hindsight/backups

# Containers to read from with docker exec. The restore drill starts a
# throwaway container from DB_CONTAINER's image.
DB_CONTAINER=hindsight-db
APP_CONTAINER=hindsight-app
DB_USER=hindsight
DB_NAME=hindsight

# Day-based retention. Only applies to this script's own timestamped files.
KEEP_LOCAL_DAYS=14
KEEP_REMOTE_DAYS=30

# Off-site copy. Leave empty for local-only backups; set to webdav once
# webdav.env holds the credentials. Once it is set, a failed upload fails the
# whole run, so a broken credential never looks like a successful backup.
UPLOAD_PROVIDER=
# Days between uploads. Local archives are still made daily. Raise this when
# the WebDAV account has a monthly upload-traffic cap; each run also downloads
# the archive again to verify it, which counts as download traffic.
UPLOAD_EVERY_N_DAYS=1
# Jianguoyun's WebDAV service address.
WEBDAV_URL=https://dav.jianguoyun.com/dav/
# Project directory on the remote. Give each project or environment its own.
WEBDAV_BASE_DIR=hindsight
